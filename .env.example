# Copy this file to .env and fill in your keys. Never commit .env to Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
# Request timeout in seconds for every AI provider
AI_TIMEOUT=25
# Provider order (comma separated). Local Python evaluation is always the final fallback.
PROVIDER_ORDER=gemini,groq,ollama
